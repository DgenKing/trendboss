{
  "name": "hl-level-monitor",
  "private": true,
  "type": "module",
  "scripts": {
    "install:app": "bash scripts/install.sh",
    "start": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "status": "bash scripts/status.sh",
    "health": "bash scripts/healthcheck.sh",
    "web": "cd packages/web && bun run dev -- --port 3000",
    "api": "bun run packages/monitor/index.ts",
    "trader": "bun run packages/trader/index.ts",
    "test": "bun test packages/core/core.test.ts packages/trader/trader.test.ts",
    "check": "bun test packages/core/core.test.ts packages/trader/trader.test.ts && bun x tsc --noEmit"
  },
  "workspaces": [
    "packages/web"
  ],
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "hyperliquid": "^1.7.7"
  }
}
